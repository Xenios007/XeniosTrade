# Dependencies
node_modules/
server/learning-bot/.venv/

# Build output
dist/

# Environment / secrets — never commit real keys
.env
.env.local
.env.*.local
# keep the template
!.env.example

# Runtime state & logs (mutable data, may contain credentials).
# Blanket rule first — server/data/ has grown many generated subdirectories
# (consolidated/, bot-claude/, backtest-research/, *.tmp-*/*.bak scratch files)
# that the older file-specific rules below don't reach recursively.
server/data/
server/data/*.json
server/data/*.log
launcher-logs/
*.log
*.err.log
*.out.log

# Prior AI-agent session scratch directories (baseline snapshots, tarballs,
# session logs from earlier deployment sessions) — working state, not source.
.deploy-consolidated/
.deploy-usdc/

# Editor / OS
.DS_Store
.idea/
*.swp

# Backtest run data & generated reports (large / machine-generated — rsync, not git)
server/data/backtest-runs/
server/backtest/runs/

# Historical market-data cache (raw Binance candles/funding — large, re-fetchable)
server/data/historical-cache/

# AI training artifacts — model binaries, checkpoints, generated datasets, reports
server/data/learning-bot-*.json
server/data/ai-training/
server/data/models/
server/learning-bot/artifacts/
server/learning-bot/**/*.pt
server/learning-bot/**/*.pth
server/learning-bot/**/*.ckpt
server/learning-bot/**/__pycache__/
server/backtest/reports/
*.parquet

# Blanket rule (defense in depth) — server/data/ has grown many generated
# subdirectories and *.bak/*.tmp-* scratch files the specific rules above
# don't reach. Never let runtime data/credentials near git.
server/data/
*.bak
*.tmp-*
