launcher-logs/
*.log
*.err.log
*.out.log

# Editor / OS
.DS_Store
.idea/
*.swp

# Backtest run data & generated reports (large / machine-generated — rsync, not git)
server/data/backtest-runs/
server/backtest/runs/
