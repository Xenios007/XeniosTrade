# Copy to .env and fill in real values. Do NOT commit .env.
# NODE_ENV is intentionally not set here — Vite rejects NODE_ENV=production in .env.
# Set it in the process manager (PM2 / systemd) instead.

HOST=0.0.0.0
PORT=3001
MOCK_TRADING_PORT=3001
SERVE_FRONTEND=true

# Login password for the private workspace (required in production).
# If unset, the server generates a random run-only password at startup.
APP_LOGIN_PASSWORD=change-me

# Send the session cookie only over HTTPS (recommended in production).
AUTH_COOKIE_SECURE=true

# Binance Futures Testnet account used by Phase 2 exchange-sync wallets.
BINANCE_TESTNET_API_KEY=your-testnet-api-key
BINANCE_TESTNET_SECRET_KEY=your-testnet-secret-key

# Optional: enables the dashboard "Manual Trade With ChatGPT" review.
# Also used by Bot GPT (Wallet 12) below unless OPENAI_BOT_GPT_MODEL is set.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# --- LLM-driven trading bots (Wallets 11-15) -------------------------------
# Each bot stays in "watching" state and never trades until its key is set.
# Every bot scans the same small fixed universe (BTC/ETH/SOL/BNB) so a
# head-to-head comparison is apples-to-apples and API spend stays bounded.
#
# Preferred: set these through the app's AI Models page (/ai-models) instead —
# it covers all 23 providers in src/lib/aiProviders.js (not just these five),
# stores the key server-side, and takes priority over the env vars below.
# The env vars here are a fallback for whichever field the page doesn't have
# a value for yet (e.g. a fresh deploy before anyone has opened the page).

# Bot 11 "Bot Claude" (Wallet 11).
# ANTHROPIC_API_KEY=
# ANTHROPIC_BOT_CLAUDE_MODEL=claude-opus-5

# Bot 12 "Bot GPT" (Wallet 12). Reuses OPENAI_API_KEY above.
# OPENAI_BOT_GPT_MODEL=gpt-4.1-mini
# OPENAI_BOT_GPT_BASE_URL=https://api.openai.com/v1

# Bot 13 "Bot Gemini" (Wallet 13), via Gemini's OpenAI-compatible endpoint.
# GEMINI_API_KEY=
# GEMINI_BOT_MODEL=gemini-2.0-flash
# GEMINI_BOT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Bot 14 "Bot Grok" (Wallet 14), via xAI's OpenAI-compatible endpoint.
# XAI_API_KEY=
# XAI_BOT_MODEL=grok-2-latest
# XAI_BOT_BASE_URL=https://api.x.ai/v1

# Bot 15 "Bot OpenRouter" (Wallet 15). Model id is any OpenRouter-served
# model, e.g. "anthropic/claude-sonnet-5" or "openai/gpt-4o" — defaults to a
# Llama model so the five-bot roster covers five distinct model families.
# OPENROUTER_API_KEY=
# OPENROUTER_BOT_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_BOT_BASE_URL=https://openrouter.ai/api/v1

# Google sign-in on the public homepage (https://console.cloud.google.com -> APIs & Services -> Credentials).
# The redirect URI below must be listed under "Authorized redirect URIs" for the OAuth client.
# GOOGLE_ALLOWED_EMAILS is a comma-separated allowlist; empty rejects every Google account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAILS=
GOOGLE_REDIRECT_URI=https://projxenios.trade/api/auth/google/callback
# Share one session across the apex and the ai./bot. subdomains.
AUTH_COOKIE_DOMAIN=.projxenios.trade
AUTH_COOKIE_SECURE=true
